# Copy this file to .env and fill in real values before running.

# Required for the AI planner. Without this, ClarifAI falls back to a
# generic heuristic cleaning plan (dtype-based defaults) so the app still
# runs end-to-end, but it won't understand your plain-English instructions.
ANTHROPIC_API_KEY=

# Which Claude model to use for plan generation.
CLARIFAI_MODEL=claude-sonnet-4-6

# Swap this to a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql://clarifai:password@localhost:5432/clarifai
DATABASE_URL=sqlite:///./clarifai.db

# Change this in production - used to sign JWTs.
CLARIFAI_SECRET_KEY=dev-secret-change-me-in-production

# Where uploaded/cleaned files are stored on disk.
CLARIFAI_UPLOAD_DIR=./uploads
